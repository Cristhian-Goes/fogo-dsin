# Copie para .env na máquina local ou cadastre os mesmos nomes na Vercel.
# Não coloque valores reais neste arquivo. Não grave segredo no código.

# development ou production
FOGO_ENV=development

# Pasta gravável do cadastro. Na Vercel use /tmp/fogo.
# Vazio mantém a pasta data/ do projeto.
FOGO_DATA=

# Origem permitida no navegador. Vazio desliga o CORS explícito.
FOGO_ORIGIN=

# Motor de rotas. O padrão é o OSRM público, sem chave.
OSRM_URL=https://router.project-osrm.org

# Segredo para POST /api/webhooks/supabase. Sem este valor o webhook responde 401.
FOGO_WEBHOOK_SECRET=

# Supabase. A central aceita estes nomes ou os da Vercel/Next (NEXT_PUBLIC_SUPABASE_URL
# e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY). A chave publicável pode ir ao navegador.
# A service role não entra no navegador e ainda não está no projeto.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile no login. A site key vai para o navegador. A secret key fica só aqui.
CF_TURNSTILE_SITEKEY=
CF_TURNSTILE_SECRET=

# Cloudflare Access. Sem os dois primeiros, a central entra só com usuário e senha.
# CF_ACCESS_TEAM é o subdomínio da equipe, por exemplo empresa
# (a URL fica https://empresa.cloudflareaccess.com).
# CF_ACCESS_AUD é a tag de audiência da aplicação, no painel Zero Trust.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# 1 exige o token da Cloudflare fora deste computador. Em 127.0.0.1 a senha continua valendo.
CF_ACCESS_REQUIRED=

# Chat. Sem nenhuma das chaves, o chat responde por regras locais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
